{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cds-cv.local/schema/red-flags.schema.json",
  "title": "RedFlagsFile",
  "description": "Pack-level red-flags.yaml. Keys are flag_id (RF-01..RF-16 per spec §4.3). Deterministic policy rules that halt the engine; NOT literature-sourced, so no citation_id is required.",
  "type": "object",
  "propertyNames": { "pattern": "^RF-[0-9]{2}$" },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "flag_id", "display_name", "clinical_rationale",
      "triggers", "trigger_logic", "halt_message", "confidence"
    ],
    "properties": {
      "flag_id": { "type": "string", "pattern": "^RF-[0-9]{2}$" },
      "display_name": { "type": "string", "minLength": 1 },
      "clinical_rationale": { "type": "string", "minLength": 1 },
      "triggers": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["finding_id", "required_state", "description"],
          "properties": {
            "finding_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "required_state": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 }
          }
        }
      },
      "trigger_logic": { "type": "string", "enum": ["ALL", "ANY"] },
      "halt_message": { "type": "string", "minLength": 1 },
      "confidence": { "type": "string", "enum": ["CERTAIN", "PROBABLE"] }
    }
  }
}